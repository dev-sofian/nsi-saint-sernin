# Modèle de configuration du serveur. ./initialiser.sh le copie en .env et remplit les clés.
# Le fichier .env contient des SECRETS : il ne doit JAMAIS être commité (il est dans .gitignore).

# Nom de domaine DuckDNS complet (https://www.duckdns.org) et la partie avant .duckdns.org
DOMAINE=nsi-saint-sernin.duckdns.org
DUCKDNS_SOUS_DOMAINE=nsi-saint-sernin
# Jeton affiché sur duckdns.org une fois connecté (SECRET)
DUCKDNS_JETON=

# Clés LiveKit : générées par ./initialiser.sh (SECRET)
LIVEKIT_CLE=
LIVEKIT_SECRET=

# Projet Firebase (public, comme dans assets/js/firebase-config.js)
FIREBASE_PROJET=nsi-saint-sernin
FIREBASE_BDD=https://nsi-saint-sernin-default-rtdb.europe-west1.firebasedatabase.app

# Sites autorisés à utiliser le serveur (séparés par des virgules, sans / final)
ORIGINES=https://dev-sofian.github.io,http://localhost:5500,http://127.0.0.1:5500
